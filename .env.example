# Supabase Edge Function secrets. Configure these with `supabase secrets set`.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_SECRET
SITE_ORIGIN=https://YOUR-DOMAIN.example
RATE_LIMIT_SALT=GENERATE_A_LONG_RANDOM_SECRET

# Contact email notifications (optional; configure a verified sender/domain).
RESEND_API_KEY=
OWNER_NOTIFICATION_EMAIL=
RESEND_FROM_EMAIL=

# Optional media provider integrations (server-side only).
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional OpenAI-compatible AI provider (server-side only).
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=
